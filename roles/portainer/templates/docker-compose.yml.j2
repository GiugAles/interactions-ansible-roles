services:
  portainer:
    image: portainer/portainer-ce:latest
    command: --log-level DEBUG  # Add your desired log level here
    container_name: portainer
    restart: always
    ports:
      - "9000:9000"
      - "9443:9443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    networks:
      - default
      - minikube

volumes:
  portainer_data:

networks:
  # required for portainer to connect to minikube
  minikube:
    name: minikube
    external: true